{
  "name": "@osm3d/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/server.ts --format esm --sourcemap --clean",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "@fastify/cors": "11.3.0",
    "@fastify/static": "10.1.3",
    "@osm3d/contracts": "workspace:*",
    "@osm3d/geo": "workspace:*",
    "@osm3d/osm": "workspace:*",
    "fastify": "5.12.1",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^24.3.1",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "5.9.3"
  }
}
