POSTGRES_DB=osm3d
POSTGRES_USER=osm3d
POSTGRES_PASSWORD=osm3d-local
DATABASE_URL=postgresql://osm3d:osm3d-local@db:5432/osm3d
API_PORT=3000
IMPORT_EXECUTION_MODE=inline
PUBLIC_APP_URL=http://localhost:5173
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OVERPASS_BASE_URL=https://overpass-api.de/api/interpreter
USGS_ELEVATION_BASE_URL=https://elevation.nationalmap.gov/arcgis/rest/services/3DEPElevation/ImageServer/getSamples
USGS_NAIP_BASE_URL=https://imagery.nationalmap.gov/arcgis/rest/services/USGSNAIPImagery/ImageServer/exportImage
ELEVATION_SAMPLE_SPACING_METERS=10
ELEVATION_MAX_GRID_DIMENSION=129
ELEVATION_SAMPLE_BATCH_SIZE=900
OSM_USER_AGENT=StreetRove/0.1 (local development)
OSM_CACHE_DIRECTORY=/data/osm
MAX_IMPORT_AREA_SQUARE_KM=4
MAX_IMPORT_RESPONSE_BYTES=25000000
LOG_LEVEL=info
VITE_API_BASE_URL=/api
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
