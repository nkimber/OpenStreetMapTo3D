{
  "name": "@osm3d/osm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "dev": "tsup src/index.ts --format esm --dts --watch",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@osm3d/contracts": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "5.9.3"
  }
}
